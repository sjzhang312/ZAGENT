<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zagent.ai.mapper.AiProviderMapper">

    <resultMap type="AiProvider" id="AiProviderResult">
        <result property="providerId" column="provider_id" />
        <result property="providerName" column="provider_name" />
        <result property="providerCode" column="provider_code" />
        <result property="apiKey" column="api_key" />
        <result property="baseUrl" column="base_url" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectAiProviderVo">
        select
            provider_id,
            provider_name,
            provider_code,
            api_key,
            base_url,
            status,
            create_by,
            create_time,
            update_by,
            update_time,
            remark
            from ai_provider
    </sql>

    <select id="selectAiProviderList" parameterType="AiProvider" resultMap="AiProviderResult">
        <include refid="selectAiProviderVo"/>
        <where>
            <if test="providerName != null and providerName != ''"> and provider_name = #{providerName}</if>
            <if test="providerCode != null and providerCode != ''"> and provider_code = #{providerCode}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by provider_id desc
    </select>

    <select id="selectAiProviderById" parameterType="Long" resultMap="AiProviderResult">
        <include refid="selectAiProviderVo"/>
        where provider_id = #{providerId}
    </select>

    <insert id="insertAiProvider" parameterType="AiProvider" useGeneratedKeys="true" keyProperty="providerId">
        insert into ai_provider
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="providerName != null and providerName != ''">provider_name,</if>
            <if test="providerCode != null and providerCode != ''">provider_code,</if>
            <if test="apiKey != null and apiKey != ''">api_key,</if>
            <if test="baseUrl != null and baseUrl != ''">base_url,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null ">create_by,</if>
            <if test="createTime != null ">create_time,</if>
            <if test="updateBy != null ">update_by,</if>
            <if test="updateTime != null ">update_time,</if>
            <if test="remark != null ">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="providerName != null and providerName != ''">#{providerName},</if>
            <if test="providerCode != null and providerCode != ''">#{providerCode},</if>
            <if test="apiKey != null and apiKey != ''">#{apiKey},</if>
            <if test="baseUrl != null and baseUrl != ''">#{baseUrl},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null ">#{createBy},</if>
            <if test="createTime != null ">#{createTime},</if>
            <if test="updateBy != null ">#{updateBy},</if>
            <if test="updateTime != null ">#{updateTime},</if>
            <if test="remark != null ">#{remark},</if>
        </trim>
    </insert>

    <update id="updateAiProvider" parameterType="AiProvider">
        update ai_provider
        <trim prefix="SET" suffixOverrides=",">
            <if test="providerName != null and providerName != ''">provider_name = #{providerName},</if>
            <if test="providerCode != null and providerCode != ''">provider_code = #{providerCode},</if>
            <if test="apiKey != null and apiKey != ''">api_key = #{apiKey},</if>
            <if test="baseUrl != null and baseUrl != ''">base_url = #{baseUrl},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null ">create_by = #{createBy},</if>
            <if test="createTime != null ">create_time = #{createTime},</if>
            <if test="updateBy != null ">update_by = #{updateBy},</if>
            <if test="updateTime != null ">update_time = #{updateTime},</if>
            <if test="remark != null ">remark = #{remark},</if>
        </trim>
        where provider_id = #{providerId}
    </update>

    <delete id="deleteAiProviderByIds" parameterType="Long">
        delete from ai_provider where provider_id in
        <foreach collection="array" item="providerId" open="(" separator="," close=")">
            #{providerId}
        </foreach>
    </delete>

</mapper>
